# Web client
NEXT_PUBLIC_API_URL="http://localhost:3101"

# Mobile client
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:3101"
EXPO_PUBLIC_PRIVACY_VERSION="2026-04-26"
EXPO_PUBLIC_CHANNEL="yingyongbao"

# Android release builds require HTTPS.
# ACP_MOBILE_RELEASE=1
# EXPO_PUBLIC_API_BASE_URL="https://api.example.com"

# Android release signing is injected from the local shell or CI secrets.
# Never commit keystores or signing passwords.
# ACP_ANDROID_KEYSTORE_FILE="C:\\secure\\release.p12"
# ACP_ANDROID_KEYSTORE_PASSWORD=""
# ACP_ANDROID_KEY_ALIAS=""
# ACP_ANDROID_KEY_PASSWORD=""
