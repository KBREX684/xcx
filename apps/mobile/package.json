{
  "name": "@agent-control-plane/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "keystore:generate": "node ./scripts/generate-release-keystore.mjs",
    "apk:debug": "node ./scripts/run-gradle.mjs assembleDebug",
    "apk:release": "node ./scripts/run-gradle.mjs assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true",
    "build:android:release": "node ./scripts/run-gradle.mjs assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true",
    "build:android:debug": "node ./scripts/run-gradle.mjs assembleDebug",
    "release-checklist": "node ./scripts/release-checklist.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/mobile/src/cache/staleCache.test.ts apps/mobile/src/services/apiClient.test.ts apps/mobile/src/telemetry/telemetryClient.test.ts apps/mobile/src/security/certificatePinning.test.ts apps/mobile/src/i18n/strings.test.ts apps/mobile/src/state/onboardingStore.test.ts",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@agent-control-plane/domain": "*",
    "@agent-control-plane/mobile-ui": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "^55.0.17",
    "expo-application": "^55.0.14",
    "expo-camera": "^55.0.16",
    "expo-constants": "^55.0.15",
    "expo-device": "^55.0.15",
    "expo-localization": "^55.0.13",
    "expo-notifications": "^55.0.20",
    "expo-secure-store": "^55.0.13",
    "expo-status-bar": "^55.0.5",
    "expo-system-ui": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "zod": "^4.3.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.6.0"
  }
}
